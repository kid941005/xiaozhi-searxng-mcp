# 默认：自动识别文本文件，仓库内统一用 LF
* text=auto eol=lf

# Shell 脚本必须是 LF —— 否则在 Linux 容器里会因为 \r 报
# "exec format error" 或 "/bin/sh^M: bad interpreter"
*.sh text eol=lf

# Dockerfile / compose / 工作流 也统一 LF
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python 源码 LF
*.py text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.mp3 binary
