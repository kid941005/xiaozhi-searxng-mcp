# ============================================================
# xiaozhi-searxng-mcp 环境变量示例
# 复制为 .env 后按需填写
#   cp .env.example .env
# ============================================================

# ---------- 必填 ----------

# 你的 SearXNG 地址（注意：要能在容器网络内访问到）
SEARXNG_URL=http://192.168.1.10:8080

# 小智 MCP 接入点。仅 MODE=bridge 时需要。
# 获取路径：xiaozhi.me 控制台 → 智能体 → 配置 → 扩展能力 → MCP接入点
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=替换成你的token

# 桥接模式的子服务声明文件路径（容器内默认 /app/mcp_config.json，一般不用改）
# MCP_CONFIG=/app/mcp_config.json

# ---------- 运行模式 ----------

# mcp    = 只跑 MCP 搜索服务（默认）
# bridge = 跑小智桥接，把 MCP 服务接到 MCP_ENDPOINT
MODE=mcp

# 仅 MODE=mcp 时生效：stdio（默认）/ http / sse
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8765

# ---------- SearXNG 调优（可选）----------

# 返回格式，必须与 SearXNG 的 search.formats 一致
SEARXNG_FORMAT=json

# 指定引擎，逗号分隔；留空用实例默认
# SEARXNG_ENGINES=baidu,bing,duckduckgo

# 搜索语言
SEARXNG_LANGUAGE=zh-CN

# 请求超时（秒）
SEARXNG_TIMEOUT=12

# 单次最多返回条数（省 token）
SEARXNG_MAX_RESULTS=8

# 若 SearXNG 前挂了鉴权网关，填 Bearer token
# SEARXNG_TOKEN=

# ---------- SearXNG 容器（仅内置 searxng 服务时需要）----------

# 生成一串随机值，防止会话伪造
SEARXNG_SECRET=change-me-to-a-random-long-string
